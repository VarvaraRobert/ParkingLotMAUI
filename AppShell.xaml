<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ParkingLotMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ParkingLotMAUI"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Parking Lots" ContentTemplate="{DataTemplate local:ParkingLotEntryPage}" />
        <ShellContent Title="Plans" ContentTemplate="{DataTemplate local:SubscriptionPlanEntryPage}" />
        <ShellContent Title="About" ContentTemplate="{DataTemplate local:AboutPage}" />
    </TabBar>
</Shell>