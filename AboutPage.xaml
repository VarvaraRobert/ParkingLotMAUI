<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingLotMAUI.AboutPage"
             Title="About">
    <VerticalStackLayout Spacing="10" Margin="10">
        <HorizontalStackLayout Spacing="10">
            <Image Source="parking_icon.png"
                   HeightRequest="64" />
            <Label FontSize="22" FontAttributes="Bold"
                   Text="ParkingLotSystem" VerticalOptions="End" />
            <Label FontSize="22" Text="v1.0" VerticalOptions="End" />
        </HorizontalStackLayout>

        <Label Text="Manage parking lots, subscription plans and subscriptions." />
        <Label Text="You can also receive reminders when a subscription is close to ending." />
    </VerticalStackLayout>
</ContentPage>