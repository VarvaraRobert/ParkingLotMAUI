<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingLotMAUI.ParkingLotPage"
             Title="Parking Lot">
    <StackLayout Margin="20">
        <Editor Placeholder="Name" Text="{Binding Name}" HeightRequest="50" />
        <Editor Placeholder="Address" Text="{Binding Address}" HeightRequest="50" />
        <Editor Placeholder="City" Text="{Binding City}" HeightRequest="50" />
        <Editor Placeholder="Capacity" Text="{Binding Capacity}" HeightRequest="50" />
        <Editor Placeholder="Hourly Rate" Text="{Binding HourlyRate}" HeightRequest="50" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Text="Save" Clicked="OnSaveButtonClicked" />
            <Button Grid.Column="1" Text="Delete" Clicked="OnDeleteButtonClicked" />
        </Grid>
    </StackLayout>
</ContentPage>