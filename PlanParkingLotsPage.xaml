<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingLotMAUI.PlanParkingLotsPage"
             Title="Plan Parking Lots">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Done" Clicked="OnDoneClicked" />
    </ContentPage.ToolbarItems>

    <StackLayout Margin="20" Spacing="12">
        <Label x:Name="PlanNameLabel"
               FontSize="20"
               FontAttributes="Bold" />

        <Label Text="Tap a parking lot to add/remove it from this plan." />

        <ListView x:Name="listView"
                  ItemSelected="OnItemSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Text="✓"
                                   IsVisible="{Binding IsAssigned}"
                                   FontAttributes="Bold" />

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding City}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Text="Back to Plan"
                Clicked="OnDoneClicked" />
    </StackLayout>
</ContentPage>